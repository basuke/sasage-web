        "prettier": "^3.8.1",
        "prettier-plugin-svelte": "^3.4.1",
        "sha1-file": "^3.0.0",
        "sharp": "^0.34.5",
        "svelte": "^5.49.1",
        "svelte-check": "^4.3.5",
        "svelte-preprocess": "^6.0.3",
        "tailwindcss": "^3.4.19",
